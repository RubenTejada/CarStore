# PostgreSQL local
DATABASE_URL="postgresql://USER@localhost:5432/carstore"

# Dominio público canónico (el mismo en build y App Service, sin / al final).
SITE_URL="https://tucarroonline.com"
# Opcionales: solo el valor content de la etiqueta de verificación de cada buscador.
GOOGLE_SITE_VERIFICATION=""
BING_SITE_VERIFICATION=""

# Google Maps JavaScript API key (https://console.cloud.google.com/google/maps-apis)
# Sin esta clave el portal funciona, pero los mapas muestran un aviso.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=""
# Opcional: Map ID para marcadores avanzados (AdvancedMarker). "DEMO_MAP_ID" sirve en desarrollo,
# pero no lleva estilo: usa un Map ID propio con el estilo de docs/google-maps-estilo.json.
NEXT_PUBLIC_GOOGLE_MAPS_MAP_ID="DEMO_MAP_ID"

# Contraseña de los usuarios demo creados por `npm run db:seed`
SEED_DEMO_PASSWORD="cambia-esta-clave"

# Claude: lee los documentos de tasas (scripts/update-rates.ts) y los anuncios que se importan
# desde otros portales. Una de las dos opciones:
#  - API de Anthropic:
ANTHROPIC_API_KEY=""
#  - Claude en Microsoft Foundry (Azure): nombre del recurso ({resource}.services.ai.azure.com) y su clave.
#    El despliegue debe llamarse como el modelo (claude-opus-5-5, ver src/lib/claude.ts).
ANTHROPIC_FOUNDRY_RESOURCE=""
ANTHROPIC_FOUNDRY_API_KEY=""

# Correo (Azure Communication Services): verificación de cuenta, recuperar contraseña, alertas diarias
# (scripts/send-alerts.ts) y solicitudes a vendedores. Sin estas variables, en desarrollo los correos
# se escriben en la consola del servidor.
AZURE_COMMUNICATION_CONNECTION_STRING=
# Remitente de un dominio verificado en el recurso de correo, p. ej. DoNotReply@tucarroonline.com
EMAIL_FROM=

# Identidad real del operador: obligatoria antes de habilitar planes pagados y alertas.
# Se publica en /legal y en el pie de los correos. No usar datos de demostración.
LEGAL_OPERATOR_NAME=""
# Opcional: cédula de persona física, solo en configuración privada. /legal muestra los últimos 4 dígitos.
# No sustituye la inscripción en el RNC ni debe guardarse en archivos versionados.
LEGAL_OPERATOR_DOCUMENT=""
LEGAL_OPERATOR_RNC=""
LEGAL_OPERATOR_ADDRESS=""
LEGAL_CONTACT_EMAIL=""

# Módulo de redes sociales (planes con «Redes sociales»): publicar en la página de Facebook y el Instagram
# profesional del dealer y leer sus métricas. App de Meta (developers.facebook.com) con «Inicio de sesión con
# Facebook para empresas»; URI de redirección válida: {SITE_URL}/api/social/meta/callback. Los permisos de
# src/lib/social/meta.ts (META_SCOPES) necesitan la revisión de la app para dealers que no sean de prueba.
# Instagram descarga la imagen desde SITE_URL: en desarrollo la URL debe ser pública (p. ej. un túnel).
META_APP_ID=""
META_APP_SECRET=""
# Clave para cifrar los tokens de las páginas: `openssl rand -base64 32`. Cambiarla obliga a reconectar.
SOCIAL_TOKEN_KEY=""
