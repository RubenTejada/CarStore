# PostgreSQL local
DATABASE_URL="postgresql://USER@localhost:5432/carstore"

# Google Maps JavaScript API key (https://console.cloud.google.com/google/maps-apis)
# Sin esta clave el portal funciona, pero los mapas muestran un aviso.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=""
# Opcional: Map ID para marcadores avanzados (AdvancedMarker). "DEMO_MAP_ID" sirve en desarrollo,
# pero no lleva estilo: usa un Map ID propio con el estilo de docs/google-maps-estilo.json.
NEXT_PUBLIC_GOOGLE_MAPS_MAP_ID="DEMO_MAP_ID"

# Contraseña de los usuarios demo creados por `npm run db:seed`
SEED_DEMO_PASSWORD="cambia-esta-clave"
